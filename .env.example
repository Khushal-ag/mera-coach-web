# Public site origin, no trailing slash. Used for canonical URLs, sitemap and share cards.
NEXT_PUBLIC_SITE_URL=
# meracoachapi origin, no trailing slash. Must be https in production.
NEXT_PUBLIC_API_BASE_URL=
# Extra hostnames for coach photos, such as a CDN. The API origin is allowed automatically.
NEXT_PUBLIC_IMAGE_HOSTS=
# true gates Add Client behind a premium plan, false lets every coach add clients.
NEXT_PUBLIC_SUBSCRIPTION_REQUIRED=

# Social profiles shown in the footer and in search results. Leave blank to hide an icon.
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_LINKEDIN=

# SHA-256 certificate fingerprint(s) of the key the Play Store signs the app with, comma separated. Lets links from
# emails (for example the Login button) open the installed app. Play Console > App integrity > App signing.
ANDROID_APP_SHA256_FINGERPRINTS=
